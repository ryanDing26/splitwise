# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb://localhost:27017/splitwise
MONGODB_URI_TEST=mongodb://localhost:27017/splitwise_test

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# Twilio SMS Configuration
# ===========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# OCR Configuration
# ===========================================
# Options: 'tesseract' (local) or 'google' (Google Vision API)
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/heic

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# ===========================================
# OTP Configuration
# ===========================================
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# ===========================================
# Frontend URL (for CORS)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# Push Notifications (optional)
# ===========================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
